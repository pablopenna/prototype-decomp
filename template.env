# Copy to .env and fill in for your machine. .env is gitignored.

# Directory containing the game's executable (your own copy of Prototype).
PROTOTYPE_GAME_DIR=/path/to/steamapps/common/Prototype

# Ghidra 12.1.2 install directory (the one containing ghidraRun).
GHIDRA_INSTALL_DIR=/path/to/ghidra_12.1.2_PUBLIC
